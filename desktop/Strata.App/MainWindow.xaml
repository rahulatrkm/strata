<Window x:Class="Strata.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Strata.App"
        Title="Strata — where your disk space went"
        Height="780" Width="1200" MinHeight="560" MinWidth="900"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- what to scan -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" Grid.Column="0">
        <TextBlock Text="Strata" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                   Foreground="{StaticResource Accent}" Margin="2,0,14,0" />
        <Button x:Name="BtnFolder" Content="Choose folder…" Click="ChooseFolder_Click" Margin="0,0,8,0" />
        <ComboBox x:Name="CmbDrives" Width="190" Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0" />
        <Button x:Name="BtnScan" Content="Scan" Style="{StaticResource Primary}" Click="Scan_Click" Margin="0,0,8,0" />
        <Button x:Name="BtnStop" Content="Stop" Click="Stop_Click" IsEnabled="False" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Right">
        <Button x:Name="BtnUnits" Content="Show GiB" Click="Units_Click" Margin="0,0,8,0" />
        <Button x:Name="BtnExport" Content="Export CSV" Click="Export_Click" IsEnabled="False" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,9" CornerRadius="7"
            Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
      <StackPanel>
        <TextBlock x:Name="TxtPath" Text="Choose a folder or a drive to begin."
                   Foreground="{StaticResource Text2}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
        <ProgressBar x:Name="Progress" Height="4" Margin="0,8,0,0" IsIndeterminate="True"
                     Visibility="Collapsed" Foreground="{StaticResource Accent}" Background="#262A33"
                     BorderThickness="0" />
        <TextBlock x:Name="TxtWarning" Margin="0,8,0,0" FontSize="12.5" Foreground="#FBBF24"
                   TextWrapping="Wrap" Visibility="Collapsed" />
      </StackPanel>
    </Border>

    <!-- headline numbers -->
    <UniformGrid Grid.Row="2" Rows="1" Margin="0,12,0,0" x:Name="Stats">
      <Border Padding="14,10" Margin="0,0,8,0" CornerRadius="7" Background="{StaticResource Panel}"
              BorderBrush="{StaticResource Line}" BorderThickness="1">
        <StackPanel>
          <TextBlock x:Name="StatTotal" Text="—" FontSize="21" FontWeight="SemiBold" />
          <TextBlock Text="total mapped" Foreground="{StaticResource Text2}" FontSize="11.5" />
        </StackPanel>
      </Border>
      <Border Padding="14,10" Margin="0,0,8,0" CornerRadius="7" Background="{StaticResource Panel}"
              BorderBrush="{StaticResource Line}" BorderThickness="1">
        <StackPanel>
          <TextBlock x:Name="StatFiles" Text="—" FontSize="21" FontWeight="SemiBold" />
          <TextBlock Text="files" Foreground="{StaticResource Text2}" FontSize="11.5" />
        </StackPanel>
      </Border>
      <Border Padding="14,10" Margin="0,0,8,0" CornerRadius="7" Background="{StaticResource Panel}"
              BorderBrush="{StaticResource Line}" BorderThickness="1">
        <StackPanel>
          <TextBlock x:Name="StatFolders" Text="—" FontSize="21" FontWeight="SemiBold" />
          <TextBlock Text="folders" Foreground="{StaticResource Text2}" FontSize="11.5" />
        </StackPanel>
      </Border>
      <Border Padding="14,10" CornerRadius="7" Background="{StaticResource Panel}"
              BorderBrush="{StaticResource Line}" BorderThickness="1">
        <StackPanel>
          <TextBlock x:Name="StatSkipped" Text="—" FontSize="21" FontWeight="SemiBold" />
          <TextBlock Text="unreadable" Foreground="{StaticResource Text2}" FontSize="11.5" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <TabControl Grid.Row="3" Margin="0,12,0,0" Background="Transparent" BorderThickness="0"
                x:Name="Tabs" SelectionChanged="Tabs_Changed">

      <TabItem Header="Map">
        <Grid Margin="0,10,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
          </Grid.ColumnDefinitions>

          <ScrollViewer Grid.Row="0" Grid.ColumnSpan="2" HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
            <StackPanel x:Name="Crumbs" Orientation="Horizontal" />
          </ScrollViewer>

          <Border Grid.Row="1" Grid.Column="0" CornerRadius="7" BorderBrush="{StaticResource Line}"
                  BorderThickness="1" ClipToBounds="True" Margin="0,0,10,0">
            <local:TreemapView x:Name="Map" />
          </Border>

          <ListView Grid.Row="1" Grid.Column="1" x:Name="ListMap" MouseDoubleClick="ListMap_DoubleClick">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding Name}" />
                <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding SizeText}" />
                <GridViewColumn Header="Share" Width="55" DisplayMemberBinding="{Binding Extra}" />
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </TabItem>

      <TabItem Header="Largest files">
        <ListView x:Name="ListBig" Margin="0,10,0,0">
          <ListView.View>
            <GridView>
              <GridViewColumn Width="34">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="File" Width="620" DisplayMemberBinding="{Binding Name}" />
              <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeText}" />
              <GridViewColumn Header="Modified" Width="110" DisplayMemberBinding="{Binding Extra}" />
            </GridView>
          </ListView.View>
        </ListView>
      </TabItem>

      <TabItem Header="Duplicates">
        <Grid Margin="0,10,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnDupes" Content="Find duplicate files" Click="FindDupes_Click" IsEnabled="False" />
            <TextBlock x:Name="TxtDupes" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{StaticResource Text2}" FontSize="12.5"
                       Text="Compared byte for byte: same size, then the first 64 KB, then the whole file." />
          </StackPanel>
          <ListView Grid.Row="1" x:Name="ListDupes">
            <ListView.View>
              <GridView>
                <GridViewColumn Width="34">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding Selectable}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="File" Width="620" DisplayMemberBinding="{Binding Name}" />
                <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeText}" />
                <GridViewColumn Header="Group" Width="150" DisplayMemberBinding="{Binding Extra}" />
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </TabItem>

      <TabItem Header="Rebuildable">
        <Grid Margin="0,10,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{StaticResource Text2}" FontSize="12.5"
                     Text="Folders a tool can recreate. This is a match on the folder's name, not proof — each row says what puts it back." />
          <ListView Grid.Row="1" x:Name="ListRebuild">
            <ListView.View>
              <GridView>
                <GridViewColumn Width="34">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Folder" Width="560" DisplayMemberBinding="{Binding Name}" />
                <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeText}" />
                <GridViewColumn Header="Recreated by" Width="200" DisplayMemberBinding="{Binding Extra}" />
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </TabItem>

      <TabItem Header="File types">
        <ListView x:Name="ListTypes" Margin="0,10,0,0">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Kind" Width="260" DisplayMemberBinding="{Binding Name}" />
              <GridViewColumn Header="Size" Width="110" DisplayMemberBinding="{Binding SizeText}" />
              <GridViewColumn Header="Share" Width="90" DisplayMemberBinding="{Binding Extra}" />
            </GridView>
          </ListView.View>
        </ListView>
      </TabItem>
    </TabControl>

    <!-- cleanup -->
    <Border Grid.Row="4" Margin="0,12,0,0" Padding="12,10" CornerRadius="7"
            Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock x:Name="TxtSelection" Text="Nothing selected." FontSize="13" />
          <TextBlock Text="Everything Strata removes goes to the Recycle Bin, so you can put it back. It never deletes permanently."
                     Foreground="{StaticResource Text2}" FontSize="11.5" Margin="0,2,0,0" />
        </StackPanel>
        <Button Grid.Column="1" x:Name="BtnClean" Content="Move selected to Recycle Bin"
                Style="{StaticResource Destructive}" Click="Clean_Click" IsEnabled="False" />
      </Grid>
    </Border>
  </Grid>
</Window>
